{
  "name": "@labelinn/mcp-server",
  "version": "2.3.0",
  "description": "LabelInn MCP Server — Let AI assistants print labels, manage printers, and control your fleet. 120+ tools for Claude, GPT, and Copilot.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "labelinn-mcp": "dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "smithery.yaml"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "labelinn",
    "printing",
    "thermal-printer",
    "zebra",
    "label",
    "claude",
    "copilot",
    "ai-agent",
    "fleet-management",
    "barcode",
    "zpl",
    "esc-pos",
    "warehouse"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/labelinn/mcp-server"
  },
  "homepage": "https://labelinn.com/developers",
  "bugs": {
    "url": "https://github.com/labelinn/mcp-server/issues"
  },
  "author": "LabelInn <arda@labelinn.com> (https://labelinn.com)",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  }
}
